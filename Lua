local function stopFly()
    Flying=false
    CurrentTarget=nil
    PauseUntil=0
    LastExpectedPosition=nil

    table.clear(CollectedPumpkins)
    PumpkinWaitUntil=0

    setNoclip(false)
    setPlayerHighlight(false)
    DisableAntiGravity()
    Status.Text="Pumpkin: None"
end


 setNoclip(false)
 setPlayerHighlight(false)
 DisableAntiGravity()
 Status.Text="Pumpkin: None"
end

local function startFly()
    if Flying then
        stopFly()
        return
    end

    Flying=true
    CurrentTarget=nil
    LastExpectedPosition=nil

    table.clear(CollectedPumpkins)
    PumpkinWaitUntil=0

    setPlayerHighlight(true)
    setNoclip(true)

    Status.Text="Đang tìm Pumpkin..."
end

