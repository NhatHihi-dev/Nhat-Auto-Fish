local function getFolder()
 Folder=workspace:FindFirstChild("PumpkinHunt")
 return Folder
end

local function isPumpkin(Object)
 if not Object then return false end
 return string.find(string.lower(Object.Name),"pumpkin",1,true)~=nil
end

local function getPart(Object)
 if not Object then return nil end
 if Object:IsA("BasePart") then return Object end
 if Object:IsA("Model") then
  if Object.PrimaryPart then return Object.PrimaryPart end
  return Object:FindFirstChildWhichIsA("BasePart",true)
 end
 return Object:FindFirstChildWhichIsA("BasePart",true)
end

local function getRoot()
 local Character=LocalPlayer.Character
 return Character and Character:FindFirstChild("HumanoidRootPart")
end

local function validPumpkin(Object)
 if not Object or not Object.Parent or not isPumpkin(Object) then return false end
 local Part=getPart(Object)
 return Part and Part.Parent
end

local function isJackOLantern(Object)
	if not Object or not Object.Parent then return false end
	return string.find(string.lower(Object.Name),"jack o' lantern",1,true)~=nil
end

local function getJackPart(Object)
	if not Object then return nil end
	if Object:IsA("BasePart") then return Object end
	if Object:IsA("Model") then
		if Object.PrimaryPart then return Object.PrimaryPart end
		local HRP=Object:FindFirstChild("HumanoidRootPart",true)
		if HRP and HRP:IsA("BasePart") then return HRP end
		return Object:FindFirstChildWhichIsA("BasePart",true)
	end
	return Object:FindFirstChildWhichIsA("BasePart",true)
end

local function getJackHumanoid(Object)
	if not Object then return nil end
	if Object:IsA("Model") then
		return Object:FindFirstChildOfClass("Humanoid")
	end
	return Object:FindFirstChildOfClass("Humanoid",true)
end

local function validJack(Object)
	if not Object or not Object.Parent or not isJackOLantern(Object) then return false end
	local Part=getJackPart(Object)
	local Humanoid=getJackHumanoid(Object)
	return Part and Part.Parent and Humanoid and Humanoid.Health>0
end

local function isPumpkinSnowman(Object)
	if not Object or not Object.Parent then return false end
	return string.find(string.lower(Object.Name),"pumpkin snowman",1,true)~=nil
end

local function validPumpkinSnowman(Object)
	if not Object or not Object.Parent or not isPumpkinSnowman(Object) then return false end
	local Part=getJackPart(Object)
	local Humanoid=getJackHumanoid(Object)
	return Part and Part.Parent and Humanoid and Humanoid.Health>0
end

local function getNextPumpkin()
    local Root=getRoot()
    local FolderNow=getFolder()
    if not Root or not FolderNow then return nil end

    local Nearest=nil
    local NearestDistance=math.huge

    for _,v in ipairs(FolderNow:GetDescendants()) do
        if validPumpkin(v) and not CollectedPumpkins[v] then
            local Part=getPart(v)
            if Part then
                local Distance=(Part.Position-Root.Position).Magnitude
                if Distance<NearestDistance then
                    NearestDistance=Distance
                    Nearest=v
                end
            end
        end
    end

    return Nearest
end

