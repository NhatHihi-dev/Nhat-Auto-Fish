	local FolderNow=getFolder()
	if not FolderNow then return end

	FolderConnection=FolderNow.DescendantRemoving:Connect(function(Object)
		if Object==CurrentTarget then
			CurrentTarget=nil
			CurrentTargetType=nil
		end
	end)
end

