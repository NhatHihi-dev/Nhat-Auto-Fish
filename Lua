RunService.Heartbeat:Connect(function(DT)
	if not Flying then
		DisableAntiGravity()
		return
	end

	local Character=LocalPlayer.Character
	local Root=getRoot()
	local Humanoid=Character and Character:FindFirstChildOfClass("Humanoid")
	if not Root or not Humanoid then
		DisableAntiGravity()
		return
	end
--// KIỂM TRA PUMPKIN ĐÃ MẤT
if CurrentTarget and CurrentTargetType=="Pumpkin" and not validPumpkin(CurrentTarget) then
	CurrentTarget=nil
	CurrentTargetType=nil
LastExpectedPosition=Root.Position
end

	EnableAntiGravity(Root)

	if os.clock()<PauseUntil then
		Status.Text="Dừng 1s..."
		return
	end

	--// TÌM TARGET
	if not CurrentTarget or not CurrentTarget.Parent then
		CurrentTarget=nil
		CurrentTargetType=nil
	end

	if not CurrentTarget then
		local JackTarget=getNearestJack()
		local SnowmanTarget=getNearestPumpkinSnowman()
		local PumpkinTarget=getNextPumpkin()

		local BestTarget=nil
		local BestType=nil
		local BestDistance=math.huge

		if JackTarget then
			local Part=getJackPart(JackTarget)
			if Part then
				local Distance=(Part.Position-Root.Position).Magnitude
				if Distance<BestDistance then
					BestTarget=JackTarget
					BestType="Jack"
					BestDistance=Distance
				end
			end
		end

		if SnowmanTarget then
			local Part=getJackPart(SnowmanTarget)
			if Part then
				local Distance=(Part.Position-Root.Position).Magnitude
				if Distance<BestDistance then
					BestTarget=SnowmanTarget
					BestType="Snowman"
					BestDistance=Distance
				end
			end
		end

		if PumpkinTarget then
			local Part=getPart(PumpkinTarget)
			if Part then
				local Distance=(Part.Position-Root.Position).Magnitude
				if Distance<BestDistance then
					BestTarget=PumpkinTarget
					BestType="Pumpkin"
					BestDistance=Distance
				end
			end
		end

		CurrentTarget=BestTarget
		CurrentTargetType=BestType
		PumpkinWaitUntil=0
	end

	if not CurrentTarget then
		Status.Text="Đang tìm Pumpkin..."
		LastExpectedPosition=Root.Position
		return
	end

	--// LẤY PART TARGET
	local TargetPart

	if CurrentTargetType=="Jack" or CurrentTargetType=="Snowman" then
		TargetPart=getJackPart(CurrentTarget)
	else
		TargetPart=getPart(CurrentTarget)
	end

	if not TargetPart then
		CurrentTarget=nil
		CurrentTargetType=nil
		PumpkinWaitUntil=0
		LastExpectedPosition=Root.Position
		return
	end

	--// KIỂM TRA TARGET
	if CurrentTargetType=="Jack" then
		if not validJack(CurrentTarget) then
			CurrentTarget=nil
			CurrentTargetType=nil
			LastExpectedPosition=Root.Position
			return
		end
	elseif CurrentTargetType=="Snowman" then
		if not validPumpkinSnowman(CurrentTarget) then
			CurrentTarget=nil
			CurrentTargetType=nil
			LastExpectedPosition=Root.Position
			return
		end
	elseif CurrentTargetType=="Pumpkin" then
		if not validPumpkin(CurrentTarget) then
			CurrentTarget=nil
			CurrentTargetType=nil
			PumpkinWaitUntil=0
			LastExpectedPosition=Root.Position
			return
		end
	end

	--// BAY THEO TARGET
	local FLY_HEIGHT=5
	if CurrentTargetType=="Jack" or CurrentTargetType=="Snowman" then
		FLY_HEIGHT=35
	end

	local TargetPosition=TargetPart.Position+Vector3.new(0,FLY_HEIGHT,0)
	local Distance=(TargetPart.Position-Root.Position).Magnitude

	if Distance<=3 then
		if CurrentTargetType=="Pumpkin" then
			if PumpkinWaitUntil==0 then
				PumpkinWaitUntil=os.clock()+PUMPKIN_WAIT_TIME
			end

			local Remaining=PumpkinWaitUntil-os.clock()

			if Remaining<=0 then
				CollectedPumpkins[CurrentTarget]=true
				CurrentTarget=nil
				CurrentTargetType=nil
				PumpkinWaitUntil=0
				Status.Text="Đang tìm Pumpkin tiếp theo..."
			else
				Status.Text="Đợi Pumpkin: "..string.format("%.1f",Remaining).."s"
			end
		else
			Status.Text="Đang đánh: "..CurrentTarget.Name
		end

		LastExpectedPosition=Root.Position
		return
	end

	--// KIỂM TRA DESYNC
	if LastExpectedPosition then
		local UnexpectedDistance=(Root.Position-LastExpectedPosition).Magnitude

		if UnexpectedDistance>MAX_DESYNC then
			PauseUntil=os.clock()+PAUSE_TIME
			LastExpectedPosition=Root.Position
			Status.Text="Phát hiện lệch >30 studs"
			return
		end
	end

	local CurrentSpeed=Distance<=100 and 3000 or SPEED
	local Alpha=math.clamp((CurrentSpeed*DT)/Distance,0,1)
	local NewPosition=Root.Position:Lerp(TargetPosition,Alpha)

	Root.CFrame=CFrame.new(NewPosition)
	LastExpectedPosition=NewPosition

	local TargetName=CurrentTarget.Name

	if CurrentTargetType=="Jack" then
		Status.Text="Jack: "..TargetName.." | "..math.floor(Distance/10+0.5).."m"
	elseif CurrentTargetType=="Snowman" then
		Status.Text="Snowman: "..TargetName.." | "..math.floor(Distance/10+0.5).."m"
	else
		Status.Text="Pumpkin: "..TargetName.." | "..math.floor(Distance/10+0.5).."m"
	end


--// ATTACK LOOP RIÊNG
task.spawn(function()
	while task.wait(ATTACK_INTERVAL) do
		if Flying then
			local Character=LocalPlayer.Character
			local Root=getRoot()

			if Character and Root and CurrentTarget and CurrentTarget.Parent then
