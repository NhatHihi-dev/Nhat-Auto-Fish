	table.insert(PumpkinESPList,{
		Group=Group,
		Main=MainPumpkin,
		Part=Part,
		Highlight=Highlight,
		Billboard=Billboard
	})
end

local function removePumpkinESP()
	for i=#PumpkinESPList,1,-1 do
		local Data=PumpkinESPList[i]
		if Data.Highlight then Data.Highlight:Destroy() end
		if Data.Billboard then Data.Billboard:Destroy() end
		table.remove(PumpkinESPList,i)
	end
end

local function updatePumpkinESP()
	if not ESPEnabled then
		removePumpkinESP()
		return
	end

	local Pumpkins=getAllPumpkins()
	local Existing={}

	for _,Data in ipairs(PumpkinESPList) do
		if Data.Main and validPumpkin(Data.Main) then
			Existing[Data.Main]=Data
		end
	end

	local NewMain={}

	for _,Pumpkin in ipairs(Pumpkins) do
		NewMain[Pumpkin]=true

		if not Existing[Pumpkin] then
			createPumpkinGroupESP({Pumpkin})
		end
	end

	for i=#PumpkinESPList,1,-1 do
		local Data=PumpkinESPList[i]

		if not Data.Main or not validPumpkin(Data.Main) or not NewMain[Data.Main] then
			if Data.Highlight then Data.Highlight:Destroy() end
			if Data.Billboard then Data.Billboard:Destroy() end
			table.remove(PumpkinESPList,i)
		end
	end
end

local function updateESPDistance()
	if not ESPEnabled then return end

	local Root=getRoot()
	if not Root then return end

	for i=#PumpkinESPList,1,-1 do
		local Data=PumpkinESPList[i]

		if not Data.Main or not validPumpkin(Data.Main) or not Data.Part or not Data.Part.Parent then
			if Data.Highlight then Data.Highlight:Destroy() end
			if Data.Billboard then Data.Billboard:Destroy() end
			table.remove(PumpkinESPList,i)
		else
			local Distance=(Root.Position-Data.Part.Position).Magnitude
			local DistanceLabel=Data.Billboard:FindFirstChild("DistanceLabel")

			if DistanceLabel then
				DistanceLabel.Text=math.floor(Distance/10+0.5).."m"
			end
		end
	end
end

