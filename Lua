local function AttackEnemyTarget(Target)
	if not Target or not Target.Parent then return end

	local Character=LocalPlayer.Character
	if not Character then return end

	local Tool=Character:FindFirstChildOfClass("Tool")
	if not Tool then return end

	local Humanoid=Target:FindFirstChildOfClass("Humanoid")
	if not Humanoid or Humanoid.Health<=0 then return end

	local TargetPart=Target:FindFirstChild("Head") or Target:FindFirstChild("UpperTorso") or Target:FindFirstChild("HumanoidRootPart")
	if not TargetPart then return end

	local Targets={{Target,TargetPart}}

	pcall(function()
		if RemoteAttack then
			RemoteAttack:FireServer(0.000000001)
		end
		if RemoteHit then
			RemoteHit:FireServer(TargetPart,Targets)
		end
	end)
end

local function getAllPumpkins()
	local FolderNow=getFolder()
	if not FolderNow then return {} end

	local Root=getRoot()
	if not Root then return {} end

	local RawPumpkins={}

	for _,v in ipairs(FolderNow:GetDescendants()) do
		if validPumpkin(v) then
			local Part=getPart(v)
			if Part and (Part.Position-Root.Position).Magnitude<=ESP_DISTANCE then
				table.insert(RawPumpkins,{
					Object=v,
					Part=Part
				})
			end
		end
	end

	local Pumpkins={}
	local Used={}

	for i,Data in ipairs(RawPumpkins) do
		if not Used[i] then
			Used[i]=true

			local Best=Data

			for j=1,#RawPumpkins do
				if not Used[j] then
					local Other=RawPumpkins[j]

					if (Other.Part.Position-Best.Part.Position).Magnitude<=PUMPKIN_GROUP_DISTANCE then
						Used[j]=true
					end
				end
			end

			table.insert(Pumpkins,Best.Object)
		end
	end

	return Pumpkins
end

